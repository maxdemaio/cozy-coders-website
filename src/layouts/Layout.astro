---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Cozy Coders — a design and engineering studio making websites and apps with personality.",
} = Astro.props;
import "@fontsource/funnel-sans/400.css";
import "@fontsource/funnel-sans/500.css";
import "@fontsource/funnel-sans/600.css";
import "@fontsource/funnel-sans/700.css";
import "../styles/global.css";
import PageReveal from "../components/PageReveal.astro";
import PressB from "../components/PressB.astro";
---

<style is:global>
  .link {
    color: var(--color-primary-deep);
    transition-property: color;
    transition-duration: 150ms;
    transition-timing-function: ease-in-out;
  }

  .link:hover {
    color: var(--color-primary);
  }
</style>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <style>
      /* hold the page until the ascii reveal takes over (PageReveal.astro); reduced-motion users skip it */
      html.ar-pending [data-reveal] { visibility: hidden; }
    </style>
    <script is:inline>
      // ?headbg=1 shows the ASCII art behind the "What we do" head (opt-in while we decide)
      try { var q = new URLSearchParams(location.search); if (q.get("headbg")) document.documentElement.dataset.headbg = q.get("headbg"); } catch (e) {}
      try { if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("ar-pending"); } catch (e) {}
      setTimeout(function () { document.documentElement.classList.remove("ar-pending"); }, 2500); // safety net if the script never runs
    </script>
  </head>
  <body class="bg-background text-ink text-xl">
    <slot />
    <PageReveal />
    <PressB />
  </body>
</html>
