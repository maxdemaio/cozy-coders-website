---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import FinalCta from "../components/FinalCta.astro";
import WorkSheet from "../components/WorkSheet.astro";
import Footsies from "../components/Footsies.astro";
import CursorFollow from "../components/CursorFollow.astro";
import InkSwitcher from "../components/InkSwitcher.astro";
import RevealSwitcher from "../components/RevealSwitcher.astro";
---

<Layout title="Cozy Coders — Home">
  <div class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <Hero />
      <WhatWeDo />
      <FinalCta />
    </main>
    <Footsies />
  </div>
  <CursorFollow />
  <InkSwitcher />
  <RevealSwitcher />
  <WorkSheet />
</Layout>
