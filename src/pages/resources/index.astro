---
// /resources: the home hero's two-column frame (copy left, the latest post as a feature
// right), then the three latest as a hairline grid in the "What we do" idiom, then every
// post as hairline rows with mono chip filters. No rounded cards, no pills: the same
// kit as the rest of the site (rebuilt 2026-10-23; the first version predated the kit).
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Footsies from "@/components/Footsies.astro";
import FinalCta from "@/components/FinalCta.astro";
import CursorFollow from "@/components/CursorFollow.astro";
import AsciiArt from "@/components/AsciiArt.astro";
import ResourceCard from "@/components/Resources/ResourceCard.astro";
import ResourceRow from "@/components/Resources/ResourceRow.astro";
import {
  RESOURCE_TYPES,
  pickLatest,
  publishedSorted,
  resourceHref,
  isExternal,
  typeLabel,
  formatFullDate,
  isoDate,
  type ResourceType,
} from "@/components/Resources/resourceMeta";

const all = publishedSorted(await getCollection("resources"));
const [feature, ...rest] = pickLatest(all, 4);
const latest = rest;

const countsByType = all.reduce<Partial<Record<ResourceType, number>>>((acc, r) => {
  acc[r.data.type] = (acc[r.data.type] ?? 0) + 1;
  return acc;
}, {});
const filterTypes = (Object.keys(RESOURCE_TYPES) as ResourceType[]).filter((t) => countsByType[t]);

const description = "Guides, checklists, and the occasional opinion from Cozy Coders on building fast, editable marketing sites.";
---

<Layout title="Resources — Cozy Coders" description={description} image="/og/resources.webp">
  <div class="min-h-screen flex flex-col">
    <Nav />
    <main class="flex-1">
      <!-- head: copy left, the newest post right -->
      <section class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] border-b border-ink-soft lg:min-h-[min(640px,80vh)]">
        <div class="flex flex-col justify-center lg:border-r lg:border-line">
        <div class="flex flex-col gap-6 max-w-[640px] px-6 pt-12 pb-12 md:px-10 lg:py-20">
          <h1 class="m-0 font-display text-[clamp(40px,5.4vw,64px)] font-semibold leading-[1.02] tracking-[-0.045em] text-ink text-balance">
            Notes from the studio.
          </h1>
          <p class="m-0 text-base md:text-[17px] leading-relaxed text-ink-muted max-w-[48ch]">
            How we build marketing sites that stay fast and stay editable. Guides, checklists, and the
            occasional opinion.
          </p>
          <a href="#all" class="cta-push cta-push--grey cta-push--lg self-start">All {all.length} <Icon name="solar:arrow-down-bold" class="w-3.5 h-3.5" /></a>
        </div>
        </div>

        {feature && (
          <a
            href={resourceHref(feature)}
            {...isExternal(feature) ? { target: "_blank", rel: "noopener noreferrer" } : {}}
            class="feature group relative grid grid-cols-1 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] bg-stage/50 hover:bg-stage transition-colors duration-200 border-t border-line lg:border-t-0"
          >
            <div class="flex flex-col justify-center gap-10 px-6 py-10 md:px-10 lg:py-16">
            <div class="flex flex-wrap items-stretch">
              <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap bg-ink text-background px-2.5 py-2">Latest</span>
              <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap text-ink-muted border border-line px-2.5 py-2">{typeLabel(feature.data.type)}</span>
              <time datetime={isoDate(feature.data.date)} class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap text-ink-muted border border-l-0 border-line px-2.5 py-2">{formatFullDate(feature.data.date)}</time>
            </div>
            <div class="flex flex-col gap-4">
              <h2 class="m-0 font-display text-[30px] md:text-[40px] lg:text-[44px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink text-balance max-w-[24ch]">{feature.data.title}</h2>
              <p class="m-0 max-w-[56ch] text-base md:text-[17px] leading-relaxed text-ink-muted">{feature.data.description}</p>
              <span class="inline-flex items-center gap-2 font-mono text-[13px] text-ink">read <span aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-0.5">→</span></span>
            </div>
            </div>
            <div class="feature-art relative min-h-[260px] md:min-h-0 md:border-l md:border-line" aria-hidden="true">
              <AsciiArt src="/hero/street.jpg" fallback="/hero/street-ascii.png" width={800} height={1067} focus="0.5,0.45" alt="" />
            </div>
          </a>
        )}
      </section>

      <!-- latest three -->
      {latest.length > 0 && (
        <section aria-labelledby="latest-heading" class="border-b border-line">
          <div class="px-6 md:px-10 pt-14 pb-8 md:pt-16 md:pb-10">
            <h2 id="latest-heading" class="m-0 font-display text-[36px] md:text-[48px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink">Recent</h2>
          </div>
          <ul class="m-0 p-0 list-none grid grid-cols-1 md:grid-cols-3 md:grid-rows-[auto_auto_1fr] border-t border-line">
            {latest.map((resource) => <ResourceCard resource={resource} />)}
          </ul>
        </section>
      )}

      <!-- all -->
      <section id="all" aria-labelledby="all-heading" class="scroll-mt-16">
        <div class="px-6 md:px-10 pt-14 pb-8 md:pt-16 md:pb-10 flex flex-wrap items-end justify-between gap-6">
          <h2 id="all-heading" class="m-0 font-display text-[36px] md:text-[48px] font-semibold leading-[1.05] tracking-[-0.03em] text-ink">
            Everything <span class="font-mono text-[0.5em] align-middle text-ink-soft" data-count>({all.length})</span>
          </h2>
          {filterTypes.length > 1 && (
            <div class="flex flex-wrap items-stretch" role="group" aria-label="Filter by type" data-filters>
              <button type="button" class="filter font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap text-ink-muted border border-line px-2.5 py-2 -ml-px first:ml-0 hover:text-ink transition-colors duration-150" data-filter="all" aria-pressed="true">All</button>
              {filterTypes.map((t) => (
                <button type="button" class="filter font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap text-ink-muted border border-line px-2.5 py-2 -ml-px hover:text-ink transition-colors duration-150" data-filter={t} aria-pressed="false">
                  {RESOURCE_TYPES[t]} <span class="text-ink-soft">{countsByType[t]}</span>
                </button>
              ))}
            </div>
          )}
        </div>
        <ul class="m-0 p-0 list-none border-t border-line" data-list>
          {all.map((resource) => <ResourceRow resource={resource} />)}
        </ul>
        <p class="hidden px-6 md:px-10 py-10 font-mono text-[13px] text-ink-muted" data-empty>nothing here yet.</p>
      </section>

      <FinalCta />
    </main>
    <Footsies />
  </div>
  <CursorFollow />
</Layout>

<style>
  /* the street photo grows in from the seam with the copy, like the other page heads */
  .feature-art {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
  }
  @media (min-width: 768px) {
    .feature-art {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 18%);
      mask-image: linear-gradient(to right, transparent 0%, #000 18%);
    }
  }
  .filter[aria-pressed="true"] { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-background); position: relative; z-index: 1; }
  .filter[aria-pressed="true"] span { color: color-mix(in oklab, var(--color-background) 60%, transparent); }
</style>

<script>
  // Progressive enhancement: everything is visible without JS. With JS, the chips hide rows that
  // don't match and the URL remembers the choice.
  const filters = document.querySelector<HTMLElement>("[data-filters]");
  const list = document.querySelector<HTMLElement>("[data-list]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const count = document.querySelector<HTMLElement>("[data-count]");

  if (filters && list) {
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const rows = Array.from(list.querySelectorAll<HTMLElement>("[data-type]"));

    const apply = (type: string, push: boolean) => {
      let shown = 0;
      for (const row of rows) {
        const match = type === "all" || row.dataset.type === type;
        row.hidden = !match;
        if (match) shown++;
      }
      for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.filter === type));
      if (empty) empty.hidden = shown > 0;
      if (count) count.textContent = `(${shown})`;
      if (push) {
        const url = new URL(location.href);
        if (type === "all") url.searchParams.delete("type");
        else url.searchParams.set("type", type);
        url.hash = "all";
        history.replaceState(null, "", url);
      }
    };

    for (const b of buttons) b.addEventListener("click", () => apply(b.dataset.filter ?? "all", true));
    const initial = new URL(location.href).searchParams.get("type");
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);
  }
</script>
