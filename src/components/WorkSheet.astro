---
// Project sheet: a side panel (native <dialog>) that opens from a work row,
// after lowercase.club. Header = name + tags + CLOSE (mono is all-caps or all-lowercase, never mixed); body = the shot, large,
// plus an optional blurb and link. All projects are rendered once and the
// chosen one is shown, so the images are build-optimised like the list.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";
import { work } from "../data/work";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.webp", { eager: true });
const imageFor = (file: string) => images[`../assets/work/${file}`]?.default;
---

<dialog id="work-sheet" class="work-sheet" aria-label="Project">
  <div class="work-sheet__panel">
    {
      work.map((item) => {
        const img = imageFor(item.image);
        return (
          <article class="work-sheet__item" data-work={item.slug} hidden>
            <header class="flex items-stretch justify-between bg-ink text-background">
              <div class="flex flex-col justify-center gap-1 px-5 py-4 min-w-0">
                <h2 class="m-0 font-mono text-[15px] font-semibold leading-none">{item.name}</h2>
                <p class="m-0 font-mono text-[11px] uppercase tracking-[0.08em] text-background/70">{item.tags.join(", ")}</p>
              </div>
              <button type="button" class="shrink-0 inline-flex items-center gap-2 font-mono text-[13px] px-5 bg-background text-ink border-l border-line hover:bg-stage transition-colors duration-150" data-work-close><Icon name="solar:close-circle-linear" class="w-4 h-4" aria-hidden="true" /> CLOSE</button>
            </header>
            <div class="flex flex-col gap-5 p-5 md:p-6">
              {img && (
                <Image
                  src={img}
                  alt={item.alt}
                  widths={[720, 1080, 1440]}
                  sizes="(min-width: 1024px) 720px, 92vw"
                  class="w-full h-auto border border-line bg-surface"
                  loading="lazy"
                  decoding="async"
                />
              )}
              {item.blurb && <p class="m-0 max-w-[60ch] text-[15px] leading-relaxed text-ink-muted">{item.blurb}</p>}
              {item.href && (
                <a href={item.href} target="_blank" rel="noopener noreferrer" class="self-start inline-flex items-center gap-2 font-mono text-[13px] text-ink bg-surface border border-line px-4 min-h-11 hover:border-ink-soft transition-colors duration-150">
                  VISIT SITE <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</dialog>

<style>
  .work-sheet {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    /* clip, not hidden: the panel sits translated past the right edge while closed, and showModal() autofocuses
       the first control inside it, which made an overflow:hidden dialog scroll sideways to reveal it: the panel
       then appeared in place with no slide and drifted on close. clip can't be scrolled, programmatically or not. */
    overflow: clip;
  }
  /* Motion (after shadcn's Sheet + the design-engineering recipe): the backdrop fades and the panel slides on
     the same drawer curve and the same clock, 400ms in, 280ms out. The dialog goes display:none → block on
     showModal(), so the open state is a class added one frame later (see script); keying it on [open] alone
     makes the panel pop in without a transition. */
  .work-sheet::backdrop {
    background: rgb(24 24 27 / 0.35);
    opacity: 0;
    transition: opacity var(--sheet-out) var(--ease-drawer);
  }
  .work-sheet.is-open::backdrop { opacity: 1; transition-duration: var(--sheet-in); }
  .work-sheet__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(760px, 92vw);
    overflow-y: auto;
    background: var(--color-background);
    /* no border-left: a zinc hairline next to the ink header read as a white sliver (Max, 2026-10-23);
       the shadow alone separates the panel from the backdrop */
    box-shadow: -24px 0 48px rgb(24 24 27 / 0.12);
    transform: translateX(100%);
    transition: transform var(--sheet-out) var(--ease-drawer);
  }
  .work-sheet.is-open .work-sheet__panel { transform: translateX(0); transition-duration: var(--sheet-in); }
  /* the content settles a beat after the panel: a short fade + 8px rise, so the sheet reads as "arrive, then present" */
  .work-sheet__item > * { opacity: 0; transform: translateY(8px); transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out); }
  .work-sheet.is-open .work-sheet__item > * { opacity: 1; transform: none; transition-delay: 120ms; }
  .work-sheet.is-open .work-sheet__item > header { transition-delay: 60ms; }
  .work-sheet__item > header { position: sticky; top: 0; z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .work-sheet__panel, .work-sheet::backdrop, .work-sheet__item > * { transition: none; }
  }
</style>

<script>
  const dialog = document.getElementById("work-sheet") as HTMLDialogElement | null;
  if (dialog) {
    const items = dialog.querySelectorAll<HTMLElement>(".work-sheet__item");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let opener: HTMLElement | null = null;

    function open(slug: string, from: HTMLElement) {
      items.forEach((it) => { it.hidden = it.dataset.work !== slug; });
      opener = from;
      dialog!.showModal();
      // let the dialog paint in its closed state first, then flip the class so the transition has a start value
      requestAnimationFrame(() => requestAnimationFrame(() => dialog!.classList.add("is-open")));
      // lock page scroll without a layout shift: pad for the scrollbar that disappears
      const gutter = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.overflow = "hidden";
      if (gutter > 0) document.documentElement.style.paddingRight = gutter + "px";
      // focus CLOSE only once the panel has arrived: focusing it while the panel is translated off-screen makes
      // the overflow:hidden dialog scroll sideways to reveal it, which is what made the sheet pop in with no slide
      setTimeout(() => dialog!.querySelector<HTMLElement>(".work-sheet__item:not([hidden]) [data-work-close]")?.focus({ preventScroll: true }), reduced ? 0 : 400);
    }
    function close() {
      if (!dialog!.open) return;
      dialog!.classList.remove("is-open");
      const done = () => {
        dialog!.close();
        document.documentElement.style.overflow = "";
        document.documentElement.style.paddingRight = "";
        opener?.focus({ preventScroll: true });
      };
      reduced ? done() : setTimeout(done, 280);
    }

    document.querySelectorAll<HTMLElement>("[data-work-open]").forEach((b) => b.addEventListener("click", () => open(b.dataset.workOpen!, b)));
    dialog.querySelectorAll("[data-work-close]").forEach((b) => b.addEventListener("click", close));
    dialog.addEventListener("click", (e) => { if (e.target === dialog) close(); }); // click on the backdrop
    dialog.addEventListener("cancel", (e) => { e.preventDefault(); close(); }); // Esc, with the exit animation
  }
</script>
