---
// Project sheet: a side panel (native <dialog>) that opens from a work row,
// after lowercase.club. Header = name + tags + Close; body = the shot, large,
// plus an optional blurb and link. All projects are rendered once and the
// chosen one is shown, so the images are build-optimised like the list.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { work } from "../data/work";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/work/*.{png,jpg,jpeg}", { eager: true });
const imageFor = (file: string) => images[`../assets/work/${file}`]?.default;
---

<dialog id="work-sheet" class="work-sheet" aria-label="Project">
  <div class="work-sheet__panel">
    {
      work.map((item) => {
        const img = imageFor(item.image);
        return (
          <article class="work-sheet__item" data-work={item.slug} hidden>
            <header class="flex items-stretch justify-between bg-ink text-background">
              <div class="flex flex-col justify-center gap-1 px-5 py-4 min-w-0">
                <h2 class="m-0 font-mono text-[15px] font-semibold leading-none">{item.name}</h2>
                <p class="m-0 font-mono text-[11px] uppercase tracking-[0.08em] text-background/70">{item.tags.join(", ")}</p>
              </div>
              <button type="button" class="shrink-0 font-mono text-[13px] px-5 bg-background text-ink border-l border-line hover:bg-stage transition-colors duration-150" data-work-close>Close</button>
            </header>
            <div class="flex flex-col gap-5 p-5 md:p-6">
              {img && (
                <Image
                  src={img}
                  alt={item.alt}
                  widths={[720, 1080, 1440]}
                  sizes="(min-width: 1024px) 720px, 92vw"
                  class="w-full h-auto border border-line bg-surface"
                  loading="lazy"
                  decoding="async"
                />
              )}
              {item.blurb && <p class="m-0 max-w-[60ch] text-[15px] leading-relaxed text-ink-muted">{item.blurb}</p>}
              {item.href && (
                <a href={item.href} target="_blank" rel="noopener noreferrer" class="self-start inline-flex items-center gap-2 font-mono text-[13px] text-ink bg-surface border border-line px-4 min-h-11 hover:border-ink-soft transition-colors duration-150">
                  Visit site <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
</dialog>

<style>
  .work-sheet {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: hidden; /* the panel slides past the right edge on close; never let that widen the page */
  }
  .work-sheet::backdrop {
    background: rgb(24 24 27 / 0.35);
    opacity: 0;
    transition: opacity 250ms ease-out;
  }
  .work-sheet[open]::backdrop { opacity: 1; }
  .work-sheet__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(760px, 92vw);
    overflow-y: auto;
    background: var(--color-background);
    border-left: 1px solid var(--color-line);
    box-shadow: -24px 0 48px rgb(24 24 27 / 0.12);
    transform: translateX(100%);
    transition: transform 250ms cubic-bezier(0.215, 0.61, 0.355, 1); /* ease-out-cubic */
  }
  .work-sheet[open] .work-sheet__panel { transform: translateX(0); }
  .work-sheet.is-closing .work-sheet__panel { transform: translateX(100%); }
  .work-sheet.is-closing::backdrop { opacity: 0; }
  .work-sheet__item > header { position: sticky; top: 0; z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .work-sheet__panel, .work-sheet::backdrop { transition: none; }
  }
</style>

<script>
  const dialog = document.getElementById("work-sheet") as HTMLDialogElement | null;
  if (dialog) {
    const items = dialog.querySelectorAll<HTMLElement>(".work-sheet__item");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let opener: HTMLElement | null = null;

    function open(slug: string, from: HTMLElement) {
      items.forEach((it) => { it.hidden = it.dataset.work !== slug; });
      opener = from;
      dialog!.classList.remove("is-closing");
      dialog!.showModal();
      // lock page scroll without a layout shift: pad for the scrollbar that disappears
      const gutter = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.overflow = "hidden";
      if (gutter > 0) document.documentElement.style.paddingRight = gutter + "px";
      requestAnimationFrame(() => dialog!.querySelector<HTMLElement>(".work-sheet__item:not([hidden]) [data-work-close]")?.focus({ preventScroll: true }));
    }
    function close() {
      if (!dialog!.open) return;
      dialog!.classList.add("is-closing");
      const done = () => {
        dialog!.close();
        dialog!.classList.remove("is-closing");
        document.documentElement.style.overflow = "";
        document.documentElement.style.paddingRight = "";
        opener?.focus({ preventScroll: true });
      };
      reduced ? done() : setTimeout(done, 250);
    }

    document.querySelectorAll<HTMLElement>("[data-work-open]").forEach((b) => b.addEventListener("click", () => open(b.dataset.workOpen!, b)));
    dialog.querySelectorAll("[data-work-close]").forEach((b) => b.addEventListener("click", close));
    dialog.addEventListener("click", (e) => { if (e.target === dialog) close(); }); // click on the backdrop
    dialog.addEventListener("cancel", (e) => { e.preventDefault(); close(); }); // Esc, with the exit animation
  }
</script>
