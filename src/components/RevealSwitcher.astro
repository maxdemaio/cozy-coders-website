---
// Dev-only panel for the page reveal (ascii-reveal). Hidden unless ?reveal is in
// the URL. Replays the work column with a chosen preset / origin / duration /
// speed via the controller PageReveal.astro exposes as window.__pageReveal.
const presets = ["dither", "decode", "terminal", "blueprint"];
const origins = ["pointer", "center", "top-left"];
const durations = ["fast", "cinematic"];
---

<aside id="rv" class="rv" hidden aria-label="Reveal options">
  <div class="rv__head"><span class="rv__title">Reveal</span><button type="button" class="rv__close" id="rv-close" aria-label="Close">×</button></div>
  <span class="rv__label">preset</span>
  <div class="rv__chips" data-group="preset">{presets.map((p) => <button type="button" class="rv__chip" data-value={p}>{p}</button>)}</div>
  <span class="rv__label">origin</span>
  <div class="rv__chips" data-group="origin">{origins.map((o) => <button type="button" class="rv__chip" data-value={o}>{o}</button>)}</div>
  <span class="rv__label">duration</span>
  <div class="rv__chips" data-group="duration">{durations.map((d) => <button type="button" class="rv__chip" data-value={d}>{d}</button>)}</div>
  <label class="rv__label" for="rv-speed">speed <span id="rv-speed-val">0.85</span></label>
  <input type="range" id="rv-speed" min="0.3" max="2" step="0.05" value="0.9" />
  <button type="button" class="rv__replay" id="rv-replay">Replay ↻</button>
  <p class="rv__hint" id="rv-url"></p>
</aside>

<style>
  .rv { position: fixed; right: 16px; bottom: 16px; z-index: 60; width: 260px; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: var(--color-surface); color: var(--color-ink); border: 1px solid var(--color-line); border-radius: 12px; box-shadow: 0 8px 24px rgb(24 24 27 / 0.1); font-family: var(--font-mono); font-size: 12px; }
  .rv__head { display: flex; align-items: center; justify-content: space-between; }
  .rv__title { font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; font-size: 11px; }
  .rv__close { font: inherit; font-size: 16px; background: none; border: 0; cursor: pointer; color: var(--color-ink-muted); padding: 2px 6px; }
  .rv__label { color: var(--color-ink-muted); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 2px; }
  .rv__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rv__chip { font: inherit; padding: 5px 9px; border-radius: 999px; border: 1px solid var(--color-line); background: var(--color-background); color: inherit; cursor: pointer; }
  .rv__chip[aria-pressed="true"] { background: var(--color-ink); color: var(--color-background); border-color: var(--color-ink); }
  .rv__replay { font: inherit; font-weight: 600; margin-top: 4px; padding: 8px 12px; border: 0; background: var(--color-ink); color: var(--color-background); cursor: pointer; }
  .rv__hint { margin: 0; color: var(--color-ink-soft); font-size: 11px; word-break: break-all; }
  input[type="range"] { width: 100%; accent-color: var(--color-primary); }
</style>

<script>
  const panel = document.getElementById("rv") as HTMLElement;
  const params = new URLSearchParams(location.search);
  if (params.has("reveal")) panel.hidden = false;

  const state: Record<string, string> = {
    preset: params.get("preset") || "dither",
    origin: params.get("origin") || "center",
    duration: params.get("duration") || "fast",
  };
  let speed = Number(params.get("speed") || 0.9);
  const speedEl = document.getElementById("rv-speed") as HTMLInputElement;
  const speedVal = document.getElementById("rv-speed-val")!;
  const url = document.getElementById("rv-url")!;
  speedEl.value = String(speed);

  function sync() {
    panel.querySelectorAll<HTMLElement>(".rv__chips").forEach((g) => {
      g.querySelectorAll<HTMLButtonElement>(".rv__chip").forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.value === state[g.dataset.group!])));
    });
    speedVal.textContent = speed.toFixed(2);
    const q = new URLSearchParams(params);
    q.set("reveal", ""); Object.entries(state).forEach(([k, v]) => q.set(k, v)); q.set("speed", String(speed));
    history.replaceState(null, "", location.pathname + "?" + q.toString().replace("reveal=&", "reveal&"));
    url.textContent = `?reveal&preset=${state.preset}&origin=${state.origin}&duration=${state.duration}&speed=${speed}`;
  }
  async function replay() {
    const r = (window as any).__pageReveal;
    if (!r) return;
    const within = document.querySelector<HTMLElement>("[data-reveal]") || undefined;
    await r.hide({ instant: true, within });
    await r.reveal({ within, preset: state.preset, origin: state.origin, duration: state.duration, speed });
  }
  panel.querySelectorAll<HTMLButtonElement>(".rv__chip").forEach((c) => c.addEventListener("click", () => {
    state[(c.parentElement as HTMLElement).dataset.group!] = c.dataset.value!; sync(); replay();
  }));
  speedEl.addEventListener("input", () => { speed = Number(speedEl.value); sync(); });
  speedEl.addEventListener("change", replay);
  document.getElementById("rv-replay")!.addEventListener("click", replay);
  document.getElementById("rv-close")!.addEventListener("click", () => { panel.hidden = true; });
  sync();
</script>
