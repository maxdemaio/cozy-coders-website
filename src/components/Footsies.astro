---
import Wordmark from "./Wordmark.astro";
import { Icon } from "astro-icon/components";

let currentYear = new Date().getFullYear();
---

<footer class="text-ink border-t border-line">
  <div
    class="px-6 md:px-10 py-8 flex flex-col md:flex-row gap-6 items-start justify-between"
  >
    <div class="flex flex-col gap-4">
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href="/" class="flex items-center gap-3 text-ink">
          <Wordmark class="h-10 w-auto" label="cozy coders, home" />
          <span class="font-mono text-[15px] [word-spacing:-0.35em]">cozy coders</span>
        </a>
        <span class="hidden sm:block self-stretch w-px bg-line" aria-hidden="true"></span>
        <p class="m-0 inline-flex items-center gap-1.5 font-mono text-[13px] text-ink-muted">
          made with
          <Icon name="solar:heart-linear" class="w-3.5 h-3.5 text-[#d6649a]" aria-label="love" />
          in massachusetts, usa
        </p>
      </div>
      <p class="m-0 font-mono text-[11px] uppercase tracking-[0.08em] text-ink-muted">© {currentYear} Cozy Coders LLC</p>
    </div>
    <div class="flex flex-col items-start md:items-end md:min-h-10 md:justify-center">
      <nav aria-label="Footer" class="flex flex-wrap gap-x-1 gap-y-3 -mx-2 font-mono text-[15px] text-ink-muted">
        <a href="/#work" class="px-2 py-1 hover:text-ink transition-colors duration-150">work,</a>
        <a href="/resources" class="px-2 py-1 hover:text-ink transition-colors duration-150">resources,</a>
        <a href="/#pricing" class="px-2 py-1 hover:text-ink transition-colors duration-150">pricing,</a>
        <a href="/contact" class="px-2 py-1 hover:text-ink transition-colors duration-150">contact</a>
      </nav>
    </div>
  </div>
</footer>
