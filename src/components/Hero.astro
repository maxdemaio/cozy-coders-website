---
import { Icon } from "astro-icon/components";
import AsciiArt from "./AsciiArt.astro";
import Wordmark from "./Wordmark.astro";
import WorkList from "./WorkList.astro";
---

<section class="hero relative bg-background border-b border-line grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
  <div class="relative flex flex-col lg:border-r lg:border-line overflow-hidden">
    <div class="relative z-10 flex flex-col gap-6 max-w-[720px] px-6 pt-12 pb-8 md:px-10 lg:pt-16">
      <div class="flex flex-col md:flex-row md:items-center gap-5 md:gap-4">
        <Wordmark class="shrink-0 h-[clamp(96px,11vw,150px)] w-auto text-ink" label="cozy" />
        <div class="min-w-0">
          <h1 class="m-0 font-display text-[clamp(40px,5.4vw,64px)] font-semibold leading-[1.02] tracking-[-0.045em] text-ink text-balance">
            Websites, apps, with personality.
          </h1>
        </div>
      </div>
      <p class="m-0 text-base md:text-[17px] leading-relaxed text-ink-muted">
        Cozy Coders is a design and engineering studio. We make websites and
        apps that feel like someone made them.
      </p>
      <div class="flex flex-wrap items-center gap-2.5">
        <a href="https://tally.so/r/mJ6yor" target="_blank" rel="noopener noreferrer" class="cta-push" data-book-url>
          Book a call
        </a>
        <a href="#what-we-do" class="cta-push cta-push--grey cta-push--lg">
          What we do <Icon name="solar:arrow-down-bold" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <AsciiArt
        src="/hero/bpl.jpg"
        fallback="/hero/bpl-ascii.png"
        width={1074}
        height={806}
        alt="Bates Hall reading room at the Boston Public Library, its barrel-vaulted ceiling and rows of green lamps rendered as sage-green text characters"
      />
    </div>
  </div>

  <div class="relative flex flex-col">
    <!-- the bubble / Framer Motion island will mount here, above the list -->
    <WorkList limit={6} />
  </div>
</section>

<style>
  .hero-art {
    position: relative;
    width: 100%;
    flex: 1 1 auto;
    /* fills the rest of the left column, so it runs down beside the work list */
    min-height: clamp(300px, 30vw, 420px);
    /* fade in from the top so the glyphs grow out of the copy, like the reference */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 22%);
  }
</style>
