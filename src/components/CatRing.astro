---
// Hero mark: Jeanette in the middle, her cat curled into a ring around her,
// asleep with its head resting by the tip of its tail. The ring drifts slowly.
import Jeanette from "./Jeanette.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Ring geometry (viewBox 300): centre 150, radius 118. The head sits at 0°,
// the body runs back over the top to 70°, the thinner tail ends at 30°.
const body = "M266.9 133.6 A118 118 0 1 0 190.4 260.9";
const tail = "M190.4 260.9 A118 118 0 0 0 252.2 209";
const stripes =
  "M205 54.7 L213 40.9 M95 54.7 L87 40.9 M40 150 L24 150 M95 245.3 L87 259.1";
---

<div
  class:list={["cat-ring relative aspect-square", className]}
  role="img"
  aria-label="Jeanette, the Cozy Coders mascot, dozing while her orange cat sleeps curled in a ring around her"
>
  <svg viewBox="0 0 300 300" class="absolute inset-0 w-full h-full overflow-visible" aria-hidden="true">
    <g class="spin" stroke-linecap="round" stroke-linejoin="round">
      <!-- sticker edge -->
      <path d={body} fill="none" stroke="#ffffff" stroke-width="42" />
      <path d={tail} fill="none" stroke="#ffffff" stroke-width="28" />
      <circle cx="268" cy="150" r="31" fill="#ffffff" />
      <!-- body and tail -->
      <path d={body} fill="none" stroke="#2C2C38" stroke-width="31" />
      <path d={body} fill="none" stroke="#FAA036" stroke-width="22" />
      <path d={stripes} fill="none" stroke="#2C2C38" stroke-width="3.5" />
      <path d={tail} fill="none" stroke="#2C2C38" stroke-width="17" />
      <path d={tail} fill="none" stroke="#FAA036" stroke-width="8.5" />
      <ellipse cx="262" cy="176" rx="9" ry="7" fill="#FAA036" stroke="#2C2C38" stroke-width="3.5" transform="rotate(20 262 176)" />
      <!-- head, ears pointing out of the ring -->
      <g transform="translate(268 150) rotate(90)" stroke="#2C2C38" stroke-width="4">
        <path d="M-18 -6 L-15 -29 L-3 -18 Z" fill="#FAA036" />
        <path class="ear" d="M3 -18 L15 -29 L18 -6 Z" fill="#FAA036" />
        <ellipse cx="0" cy="0" rx="23" ry="19" fill="#FAA036" />
        <path d="M-3 -17 L-3 -13 M3 -17 L3 -13" fill="none" stroke-width="2.4" />
        <path d="M-13 1 Q-8 5.5 -3 1 M3 1 Q8 5.5 13 1" fill="none" stroke-width="3" />
        <path d="M-3.5 9 Q-1.75 11.5 0 9 Q1.75 11.5 3.5 9" fill="none" stroke-width="2.2" />
      </g>
    </g>
  </svg>
  <div class="absolute left-1/2 top-[52%] w-[58%] -translate-x-1/2 -translate-y-1/2">
    <Jeanette uid="ring" cat={false} class="w-full h-auto" />
  </div>
</div>

<style>
  .spin {
    transform-box: view-box;
    transform-origin: 150px 150px;
    animation: spin 80s linear infinite;
  }
  .ear {
    transform-box: fill-box;
    transform-origin: 0% 100%;
    animation: twitch 5.5s infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes twitch {
    0%, 76%, 100% { transform: rotate(0); }
    80% { transform: rotate(16deg); }
    84% { transform: rotate(0); }
    88% { transform: rotate(9deg); }
    92% { transform: rotate(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-ring * {
      animation: none !important;
    }
  }
</style>
