---
// One post as a column in a hairline grid (the "What we do" idiom): a chip row with the type and
// the date, the title in Funnel Sans, the description, and a mono "read →". No cover image
// and no rounded card; the grid's rules do the framing. Renders as an <li> for the grid's <ul>.
import {
  ctaLabel,
  formatMonthYear,
  isExternal,
  isoDate,
  resourceHref,
  typeLabel,
  type Resource,
} from "./resourceMeta";

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
const { title, description, date, type } = resource.data;
const href = resourceHref(resource);
const external = isExternal(resource);
const cta = ctaLabel(resource).toLowerCase();
---

<li
  class="card group relative flex flex-col md:grid md:grid-rows-subgrid md:row-span-3 border-b border-line md:border-b-0 md:border-r last:border-r-0 hover:bg-stage/40 transition-colors duration-200"
  data-type={type}
>
  <div class="flex flex-wrap items-stretch border-b border-line">
    <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap bg-ink text-background border-b border-ink -mb-px px-2.5 py-2">{typeLabel(type)}</span>
    <time datetime={isoDate(date)} class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap text-ink-muted border-r border-line px-2.5 py-2">{formatMonthYear(date)}</time>
  </div>
  <h3 class="m-0 px-5 md:px-6 pt-6 pb-3 font-display text-[22px] md:text-[24px] font-semibold leading-[1.15] tracking-[-0.02em] text-ink text-balance">
    <a
      href={href}
      class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
      {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
    >
      {title}
    </a>
  </h3>
  <div class="flex flex-col gap-5 px-5 md:px-6 pb-7">
    <p class="m-0 max-w-[40ch] text-[15px] leading-relaxed text-ink-muted">{description}</p>
    <span class="mt-auto inline-flex items-center gap-2 font-mono text-[13px] text-ink" aria-hidden="true">
      {cta} <span class="transition-transform duration-150 group-hover:translate-x-0.5">{external ? "↗" : "→"}</span>
    </span>
  </div>
</li>

<style>
  .card:focus-within { outline: 2px solid var(--color-primary); outline-offset: -2px; }
</style>
