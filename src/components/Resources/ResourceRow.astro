---
// One post as a hairline row in the "all" list, after the home work list: type chip and date
// in the first column, the title in Funnel Sans, the description, a mono "read →" on the right.
import {
  ctaLabel,
  formatMonthYear,
  isExternal,
  isoDate,
  resourceHref,
  typeLabel,
  type Resource,
} from "./resourceMeta";

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
const { title, description, date, type } = resource.data;
const href = resourceHref(resource);
const external = isExternal(resource);
const cta = ctaLabel(resource).toLowerCase();
---

<li
  class="row group relative grid grid-cols-1 gap-3 px-6 md:px-10 py-6 md:py-7 md:grid-cols-[240px_1fr_auto] md:gap-8 md:items-start border-b border-line hover:bg-stage/40 transition-colors duration-200"
  data-type={type}
>
  <div class="flex flex-wrap items-stretch self-start">
    <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap bg-ink text-background px-2.5 py-2">{typeLabel(type)}</span>
    <time datetime={isoDate(date)} class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none whitespace-nowrap text-ink-muted border border-l-0 border-line px-2.5 py-2">{formatMonthYear(date)}</time>
  </div>

  <div class="flex flex-col gap-2 min-w-0">
    <h3 class="m-0 font-display text-[22px] md:text-[26px] font-semibold leading-[1.15] tracking-[-0.02em] text-ink text-balance">
      <a
        href={href}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
        {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
      >
        {title}
      </a>
    </h3>
    <p class="m-0 max-w-[64ch] text-[15px] leading-relaxed text-ink-muted">{description}</p>
  </div>

  <span class="inline-flex items-center gap-2 font-mono text-[13px] text-ink md:pt-1.5" aria-hidden="true">
    {cta} <span class="transition-transform duration-150 group-hover:translate-x-0.5">{external ? "↗" : "→"}</span>
  </span>
</li>

<style>
  .row:focus-within { outline: 2px solid var(--color-primary); outline-offset: -2px; }
</style>
