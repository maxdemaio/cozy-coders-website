---
// Home-page mouse follower: a small sage dot that trails the pointer with easing
// and opens into a ring over links. The real cursor stays. Off on touch devices
// and under reduced motion.
---

<div class="cf" aria-hidden="true"><div class="cf__dot"></div></div>

<style>
  .cf { display: none; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cf { display: contents; }
  }
  .cf__dot {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--color-primary);
    opacity: 0;
    pointer-events: none;
    will-change: transform;
    transition: opacity 240ms ease, width 180ms ease, height 180ms ease, margin 180ms ease, background-color 180ms ease, box-shadow 180ms ease;
  }
  .cf.is-on .cf__dot { opacity: 0.55; }
  .cf__dot.is-over {
    width: 32px;
    height: 32px;
    margin: -16px 0 0 -16px;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-primary);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".cf");
  if (root && getComputedStyle(root).display !== "none") {
    const dot = root.querySelector<HTMLElement>(".cf__dot")!;
    let tx = -100, ty = -100, x = tx, y = ty, raf = 0;
    const interactive = "a, button, [role=button], input, select, textarea, label";

    function frame() {
      x += (tx - x) * 0.16;
      y += (ty - y) * 0.16;
      dot.style.transform = `translate(${x}px, ${y}px)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.1 ? requestAnimationFrame(frame) : 0;
    }

    window.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      tx = e.clientX; ty = e.clientY;
      root!.classList.add("is-on");
      dot.classList.toggle("is-over", !!(e.target as Element | null)?.closest?.(interactive));
      if (!raf) raf = requestAnimationFrame(frame);
    }, { passive: true });
    document.addEventListener("pointerleave", () => root!.classList.remove("is-on"));
  }
</script>
