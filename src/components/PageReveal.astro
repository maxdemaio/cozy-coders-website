---
// Page-load reveal: elements marked `data-reveal` decode into place through a
// character grid (ascii-reveal, "dither" preset, wave from the centre, fast, speed 0.9 — chosen 2026-10-22).
// Used selectively — on the home page only the work column (right side of the hero).
// Framework-free core, so no React island. The inline head script in Layout.astro
// adds `ar-pending` so those parts don't flash before this runs.
---

<script>
  import { createAsciiReveal } from "ascii-reveal/core";

  const root = document.querySelector<HTMLElement>("main");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  async function run() {
    if (!root) return;
    try { await document.fonts.ready; } catch {}
    const reveal = createAsciiReveal(root, {
      preset: "dither",
      origin: "center",
      selector: "[data-reveal]",
      duration: "fast",
      speed: 0.9,
      lazy: true,
    });
    document.documentElement.classList.remove("ar-pending");
    await reveal.reveal();
  }

  // plays on every load (a once-per-session gate was tried 2026-10-23 and dropped: a refresh should decode too)
  if (reduced) {
    document.documentElement.classList.remove("ar-pending");
  } else {
    run();
  }
</script>
