---
// "What we do": three services, each with a small mockup of the actual thing
// (after aceternity's services: show the product, don't describe it), plus the
// CTAs under the cards (after quick14's #services). Mockups are plain HTML/CSS
// in our own stack: a Figma comment thread, a Tailwind token block, a deploy log.
import { Icon } from "astro-icon/components";
import AsciiArt from "./AsciiArt.astro";
---

<section id="what-we-do" class="scroll-mt-16"><!-- the divider above is the hero's border-b, so the ASCII art can never paint over it -->
  <!-- Section head: "What we do" large in the pixel mono, olive, weight 400 (after lowercase.club's
       headings), then the pitch in Funnel Sans. Optional faded ASCII photo behind (html[data-headbg], ?headbg=1). -->
  <div class="wwd-head relative overflow-hidden px-6 md:px-10 pt-16 pb-12 md:pt-24 md:pb-16 flex flex-col items-start text-left">
    <div class="wwd-bg absolute inset-0 pointer-events-none" aria-hidden="true">
      <AsciiArt src="/hero/bpl.jpg" fallback="/hero/bpl-ascii.png" width={1074} height={806} cell={3} levels="0.35,0.98,0.9" alt="" />
    </div>
    <h2 class="wwd-h relative m-0 font-mono text-[33px] md:text-[44px] font-normal leading-[1.25] [word-spacing:-0.3em] text-primary">what we do</h2>
    <p class="relative m-0 mt-5 max-w-[52ch] font-sans text-[17px] leading-[26px] text-ink-muted text-pretty"><span class="font-mono uppercase text-primary-deep">Take one, or all three.</span> Design that looks like you, a site or app that works, and someone who answers when you message. On a project or a monthly retainer.</p>
  </div>

  <ul class="m-0 p-0 list-none grid grid-cols-1 md:grid-cols-3 border-t border-line">
    <!-- 1 · Product design: a Figma comment thread -->
    <li class="flex flex-col border-b border-line md:border-b-0 md:border-r">
      <div class="flex items-stretch">
        <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none bg-ink text-background px-2.5 py-2">Product design</span>
        <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none text-ink-muted border-r border-b border-line px-2.5 py-2">You're in the room</span>
      </div>
      <div class="mock bg-stage/60 px-5 pt-6 pb-0 md:px-6" aria-hidden="true">
        <div class="mock-frame relative mx-auto w-full max-w-[300px] h-[190px] bg-surface border border-line rounded-t-lg overflow-hidden">
          <div class="h-7 flex items-center gap-1.5 px-3 border-b border-line">
            <span class="w-2 h-2 rounded-full bg-line"></span><span class="w-2 h-2 rounded-full bg-line"></span><span class="w-2 h-2 rounded-full bg-line"></span>
            <span class="ml-2 font-mono text-[9px] text-ink-soft">Homepage · v3</span>
          </div>
          <div class="p-4 flex flex-col gap-2">
            <div class="h-3 w-1/2 bg-ink/80 rounded-sm"></div>
            <div class="h-2 w-3/4 bg-line rounded-sm"></div>
            <div class="h-2 w-2/3 bg-line rounded-sm"></div>
            <div class="mt-2 h-6 w-24 bg-primary/80 rounded-sm"></div>
          </div>
          <div class="mock-pin absolute right-[158px] top-[56%] w-5 h-5 rounded-full rounded-bl-none bg-primary border-2 border-surface shadow-sm"></div>
          <div class="mock-comment absolute right-3 top-[62%] w-[150px] bg-surface border border-line rounded-md shadow-md p-2.5">
            <div class="flex items-center gap-1.5">
              <span class="w-4 h-4 rounded-full bg-ink text-background grid place-items-center font-mono text-[8px] font-semibold">M</span>
              <span class="font-sans text-[10px] font-semibold text-ink">Max</span>
              <span class="font-mono text-[8px] text-ink-soft">now</span>
            </div>
            <p class="m-0 mt-1 font-sans text-[10px] leading-snug text-ink">Swapped the hero photo for the one from your shoot — take a look?</p>
            <div class="mt-1.5 flex items-center gap-1 font-mono text-[8px] text-primary-deep"><Icon name="solar:check-circle-bold" class="w-2.5 h-2.5" /> resolved</div>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-2 px-5 md:px-6 pt-5 pb-8">
        <h3 class="m-0 text-[17px] font-semibold tracking-[-0.01em] text-ink">Design you can sit in on</h3>
        <p class="m-0 max-w-[40ch] text-[15px] leading-relaxed text-ink-muted">You watch it take shape and leave comments right on the design. No big reveal at the end, no surprises.</p>
      </div>
    </li>

    <!-- 2 · Design systems: a Tailwind theme block -->
    <li class="flex flex-col border-b border-line md:border-b-0 md:border-r">
      <div class="flex items-stretch">
        <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none bg-ink text-background px-2.5 py-2">Brand &amp; identity</span>
        <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none text-ink-muted border-r border-b border-line px-2.5 py-2">Looks like one company</span>
      </div>
      <div class="mock bg-stage/60 px-5 pt-6 pb-0 md:px-6" aria-hidden="true">
        <div class="mock-frame mx-auto w-full max-w-[300px] h-[190px] bg-surface border border-line rounded-t-lg overflow-hidden">
          <div class="h-7 flex items-center gap-2 px-3 border-b border-line font-mono text-[9px] text-ink-soft">Brand guide · your company</div>
          <div class="p-4 grid grid-cols-[1fr_1.4fr] gap-3">
            <div class="flex flex-col gap-2">
              <div class="flex gap-1.5"><span class="w-6 h-6 rounded-sm bg-ink"></span><span class="w-6 h-6 rounded-sm bg-primary"></span><span class="w-6 h-6 rounded-sm bg-stage border border-line"></span><span class="w-6 h-6 rounded-sm bg-surface border border-line"></span></div>
              <div class="font-sans text-[13px] font-semibold text-ink leading-none mt-1">Aa</div>
              <div class="font-mono text-[9px] text-ink-muted leading-none">Aa 0123</div>
              <div class="h-5 w-16 bg-ink rounded-sm mt-1"></div>
            </div>
            <div class="grid grid-cols-3 gap-1.5 items-end">
              <div class="h-[92px] bg-stage/70 border border-line rounded-sm p-1.5 flex flex-col gap-1"><span class="h-1.5 w-6 bg-ink rounded-sm"></span><span class="h-1 w-8 bg-line rounded-sm"></span><span class="mt-auto h-3 w-7 bg-primary rounded-sm"></span></div>
              <div class="h-[74px] bg-stage/70 border border-line rounded-sm p-1.5 flex flex-col gap-1"><span class="h-1.5 w-5 bg-ink rounded-sm"></span><span class="h-1 w-6 bg-line rounded-sm"></span><span class="mt-auto h-3 w-6 bg-primary rounded-sm"></span></div>
              <div class="h-[56px] bg-stage/70 border border-line rounded-sm p-1.5 flex flex-col gap-1"><span class="h-1.5 w-4 bg-ink rounded-sm"></span><span class="mt-auto h-2.5 w-5 bg-primary rounded-sm"></span></div>
              <span class="col-span-3 font-mono text-[8px] text-ink-soft text-center">site · app · deck</span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-2 px-5 md:px-6 pt-5 pb-8">
        <h3 class="m-0 text-[17px] font-semibold tracking-[-0.01em] text-ink">A brand that holds together</h3>
        <p class="m-0 max-w-[40ch] text-[15px] leading-relaxed text-ink-muted">Logo, colours, type and the rules for using them, so your site, your app and your deck all look like the same company.</p>
      </div>
    </li>

    <!-- 3 · Websites & apps: a deploy log -->
    <li class="flex flex-col">
      <div class="flex items-stretch">
        <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none bg-ink text-background px-2.5 py-2">Websites &amp; apps</span>
        <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] leading-none text-ink-muted border-r border-b border-line px-2.5 py-2">Live &amp; fast</span>
      </div>
      <div class="mock bg-stage/60 px-5 pt-6 pb-0 md:px-6" aria-hidden="true">
        <div class="mock-frame mx-auto w-full max-w-[300px] h-[190px] bg-surface border border-line rounded-t-lg overflow-hidden">
          <div class="h-7 flex items-center gap-2 px-3 border-b border-line font-mono text-[9px] text-ink-soft"><Icon name="solar:rocket-bold-duotone" class="w-3 h-3 text-primary-deep" /> yoursite.com</div>
          <ol class="m-0 p-4 list-none flex flex-col gap-2.5 font-sans text-[11px]">
            <li class="flex items-center gap-2 text-ink"><Icon name="solar:check-circle-bold" class="w-3.5 h-3.5 text-primary" /> Live <span class="ml-auto font-mono text-[9px] text-ink-soft">Tue 2:14 pm</span></li>
            <li class="flex items-center gap-2 text-ink"><Icon name="solar:check-circle-bold" class="w-3.5 h-3.5 text-primary" /> Loads in under a second <span class="ml-auto font-mono text-[9px] text-ink-soft">on 4G</span></li>
            <li class="flex items-center gap-2 text-ink"><Icon name="solar:check-circle-bold" class="w-3.5 h-3.5 text-primary" /> Found on Google <span class="ml-auto font-mono text-[9px] text-ink-soft">100 / 100</span></li>
            <li class="flex items-center gap-2 text-ink"><span class="mock-dot w-3.5 h-3.5 rounded-full border-2 border-primary border-t-transparent"></span> You edited the About page <span class="ml-auto font-mono text-[9px] text-ink-soft">just now</span></li>
          </ol>
        </div>
      </div>
      <div class="flex flex-col gap-2 px-5 md:px-6 pt-5 pb-8">
        <h3 class="m-0 text-[17px] font-semibold tracking-[-0.01em] text-ink">Sites and apps that just work</h3>
        <p class="m-0 max-w-[40ch] text-[15px] leading-relaxed text-ink-muted">Fast on every phone, found on Google, and you can change the words yourself without calling us.</p>
      </div>
    </li>
  </ul>

  <!-- CTAs under the cards, like quick14 -->
  <div class="border-t border-line px-6 md:px-10 py-8 flex flex-wrap items-center justify-center gap-3">
    <a href="https://tally.so/r/mJ6yor" target="_blank" rel="noopener noreferrer" class="cta-push">Book a free intro call</a>
    <a href="/#pricing" class="cta-push cta-push--grey cta-push--lg">See pricing</a>
  </div>
</section>

<style>
  /* after lowercase.club's "hills we'll die on": heading at weight 400 in the brand colour, 20px gap, then body at
     16-17px whose first phrase is an uppercase mono lead-in at the SAME size as the sans that follows (measured: their
     label is 16px mono, their body 16px sans, both on a 24px line). Departure Mono sizes stay on its 11px grid (33 / 44). */
  /* art behind the head: lighter levels, faded at every edge, so it reads as texture under the copy */
  .wwd-bg {
    opacity: 0.55;
    /* weighted to the right half so the copy sits on clear paper, like the hero */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent), linear-gradient(to right, transparent 35%, #000 60%, #000 90%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 25%, #000 75%, transparent), linear-gradient(to right, transparent 35%, #000 60%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  :global(html:not([data-headbg="1"])) .wwd-bg { display: none; } /* opt-in via ?headbg=1 while we decide */
  @media (max-width: 769px) { .wwd-bg { display: none; } } /* the copy spans the full width on phones; nothing to sit the art beside */
  .mock-frame { box-shadow: 0 1px 2px rgb(24 24 27 / 0.06), 0 8px 24px -12px rgb(24 24 27 / 0.25); }
  .mock-comment { animation: mock-pop 600ms cubic-bezier(0.215, 0.61, 0.355, 1) both; animation-delay: 400ms; }
  .mock-pin { animation: mock-pop 400ms cubic-bezier(0.215, 0.61, 0.355, 1) both; animation-delay: 200ms; }
  .mock-dot { animation: mock-spin 900ms linear infinite; }
  @keyframes mock-pop { from { opacity: 0; transform: translateY(6px) scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes mock-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .mock-comment, .mock-pin, .mock-dot { animation: none; }
  }
</style>
