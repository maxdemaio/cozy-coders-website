---
// Jeanette, the cozy mascot: the napping space girl redrawn as a sticker.
// `uid` keeps the die-cut silhouette id unique when she appears twice on a page.
interface Props {
  uid: string;
  label?: string;
  /** Draw the cat loafing on her head. Off when the cat is drawn elsewhere. */
  cat?: boolean;
  class?: string;
}

const { uid, label, cat = true, class: className = "" } = Astro.props;
const sil = `jeanette-sil-${uid}`;
---

<svg
  viewBox="0 0 200 190"
  class:list={["jeanette", className]}
  {...label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" }}
>
  <defs>
    <g id={sil}>
      <path d="M100 24 C138 24 160 46 158 74 C157 90 168 98 165 114 C162 128 152 132 158 146 C162 158 150 166 140 158 C134 152 132 142 128 134 L74 134 C72 140 68 146 62 146 C54 146 50 138 53 130 C56 120 48 112 48 100 C47 88 52 82 52 72 C52 44 68 24 100 24 Z" />
      <path d="M60 118 L140 118 L146 150 L54 150 Z" />
      <path d="M70 148 L130 148 L130 168 L70 168 Z" />
      <ellipse cx="84" cy="171" rx="16" ry="7.5" />
      <ellipse cx="116" cy="171" rx="16" ry="7.5" />
      {cat && (
        <>
          <ellipse cx="120" cy="30" rx="19" ry="12" />
          <path d="M104 28 L108 13 L117 22 Z M123 22 L133 13 L136 28 Z" />
        </>
      )}
    </g>
  </defs>
  <ellipse class="shadow" cx="100" cy="181" rx="48" ry="5" fill="#2C2C38" />
  <g class="bob" stroke="#2C2C38" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <use href={`#${sil}`} fill="#ffffff" stroke="#ffffff" stroke-width="16" />
    <!-- long wavy hair, behind everything -->
    <path d="M100 24 C138 24 160 46 158 74 C157 90 168 98 165 114 C162 128 152 132 158 146 C162 158 150 166 140 158 C134 152 132 142 128 134 L74 134 C72 140 68 146 62 146 C54 146 50 138 53 130 C56 120 48 112 48 100 C47 88 52 82 52 72 C52 44 68 24 100 24 Z" fill="#2C2C38" />
    <path d="M158 92 C161 99 158 106 161 112 M150 130 C147 136 151 142 148 148" fill="none" stroke="#ffffff" stroke-width="2.5" />
    <!-- legs and shoes -->
    <path d="M72 150 L72 164 Q72 167 75 167 L95 167 Q98 167 98 164 L98 150 Z" fill="#82A488" />
    <path d="M102 150 L102 164 Q102 167 105 167 L125 167 Q128 167 128 164 L128 150 Z" fill="#82A488" />
    <ellipse cx="84" cy="171" rx="15" ry="6.5" fill="#2C2C38" />
    <ellipse cx="116" cy="171" rx="15" ry="6.5" fill="#2C2C38" />
    <!-- sweater -->
    <path d="M78 114 C68 116 63 126 63 138 L63 146 Q63 151 68 151 L132 151 Q137 151 137 146 L137 138 C137 126 132 116 122 114 Z" fill="#ffffff" />
    <path d="M64 143 L136 143 M76 144 L76 150 M88 144 L88 150 M100 144 L100 150 M112 144 L112 150 M124 144 L124 150" fill="none" stroke-width="2.5" />
    <path d="M93 106 L93 116 Q100 120 107 116 L107 106 Z" fill="#FFDBD5" />
    <path d="M86 114 Q100 123 114 114" fill="none" stroke-width="3" />
    <!-- sleeves and hands -->
    <path d="M68 120 C58 128 55 138 56 146 L67 146 C67 138 69 132 73 128 Z" fill="#ffffff" />
    <path d="M57 142 L67 142" fill="none" stroke-width="2.5" />
    <ellipse cx="61.5" cy="150" rx="5.5" ry="5" fill="#FFDBD5" />
    <path d="M132 120 C142 128 145 138 144 146 L133 146 C133 138 131 132 127 128 Z" fill="#ffffff" />
    <path d="M133 142 L143 142" fill="none" stroke-width="2.5" />
    <ellipse cx="138.5" cy="150" rx="5.5" ry="5" fill="#FFDBD5" />
    <!-- face -->
    <ellipse cx="66" cy="90" rx="6" ry="8" fill="#FFDBD5" />
    <ellipse cx="100" cy="84" rx="35" ry="33" fill="#FFDBD5" />
    <path class="lids" d="M80 91 Q87 97 94 91 M106 91 Q113 97 120 91 M83 94.5 L81.5 98 M87.5 95.5 L87 99 M112.5 95.5 L113 99 M117 94.5 L118.5 98" fill="none" stroke-width="3" />
    <ellipse cx="78" cy="103" rx="6.5" ry="3.6" fill="#F4A9A0" stroke="none" />
    <ellipse cx="122" cy="103" rx="6.5" ry="3.6" fill="#F4A9A0" stroke="none" />
    <path d="M96 105 Q100 108.5 104 105" fill="none" stroke-width="3" />
    <!-- bangs and wavy front locks -->
    <path d="M66 82 C62 54 80 40 102 40 C126 40 142 54 137 86 C130 72 120 64 106 61 C96 70 82 78 66 82 Z" fill="#2C2C38" />
    <path d="M90 48 C97 45 105 45 112 47" fill="none" stroke="#ffffff" stroke-width="2.5" />
    <g class="sway-r">
      <path d="M132 66 C150 80 140 98 150 110 C158 120 146 130 154 142 C156 150 146 154 140 146 C134 138 140 128 134 118 C130 110 136 98 130 86 Z" fill="#2C2C38" />
      <path d="M145 104 C148 110 144 116 147 122 M146 130 C144 135 147 139 145 143" fill="none" stroke="#ffffff" stroke-width="2.2" />
    </g>
    {cat && (
      <>
        <g class="tail">
          <path d="M138 32 C149 30 153 21 148 13" fill="none" stroke-width="9" />
          <path d="M138 32 C149 30 153 21 148 13" fill="none" stroke="#FAA036" stroke-width="4" />
        </g>
        <path d="M104 28 L108 13 L117 22 Z" fill="#FAA036" />
        <path class="twitch" d="M123 22 L133 13 L136 28 Z" fill="#FAA036" />
        <ellipse cx="120" cy="30" rx="19" ry="12" fill="#FAA036" />
        <path d="M118 19.5 L118 22.5 M123 19.5 L123 22.5" fill="none" stroke-width="2" />
        <path d="M109 29.5 Q113.5 34 118 29.5 M123 29.5 Q127.5 34 132 29.5" fill="none" stroke-width="2.6" />
        <path d="M117 36 Q118.7 38.4 120.5 36 Q122.3 38.4 124 36" fill="none" stroke-width="2" />
      </>
    )}
  </g>
</svg>

<style>
  .jeanette {
    display: block;
    overflow: visible;
  }
  .bob {
    transform-box: view-box;
    transform-origin: 100px 178px;
    animation: bob 3.4s ease-in-out infinite;
  }
  .shadow {
    transform-box: fill-box;
    transform-origin: center;
    animation: shadow 3.4s ease-in-out infinite;
  }
  .lids {
    transform-box: fill-box;
    transform-origin: center;
    animation: lids 6s ease-in-out infinite;
  }
  .twitch {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: twitch 5.5s infinite;
  }
  .tail {
    transform-box: fill-box;
    transform-origin: 0% 100%;
    animation: tail 2.6s ease-in-out infinite;
  }
  .sway-r {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: sway 3.4s ease-in-out infinite;
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
  @keyframes shadow {
    0%, 100% { transform: scaleX(1); opacity: 0.14; }
    50% { transform: scaleX(0.9); opacity: 0.09; }
  }
  @keyframes lids {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(0.6px); }
  }
  @keyframes twitch {
    0%, 76%, 100% { transform: rotate(0); }
    80% { transform: rotate(-18deg); }
    84% { transform: rotate(0); }
    88% { transform: rotate(-10deg); }
    92% { transform: rotate(0); }
  }
  @keyframes tail {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(14deg); }
  }
  @keyframes sway {
    0%, 100% { transform: rotate(0); }
    50% { transform: rotate(2.5deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .jeanette * {
      animation: none !important;
    }
  }
</style>
